---
import Window from './Window.astro';
import { getLangFromUrl } from '../i18n/utils';
import { contact } from '../data/content';

const lang = getLangFromUrl(Astro.url);
---

<div id="contact" class="scroll-mt-6">
  <Window id="win-contact" title={contact.title[lang]}>
    <h3 class="font-cyber text-lg font-semibold text-neon-pink">{contact.heading[lang]}</h3>
    <p class="mt-2 max-w-prose text-ink-dim">{contact.message[lang]}</p>
    <p class="mt-3 text-neon-cyan">{contact.email}</p>

    <ul class="mt-4 flex flex-wrap gap-2">
      {
        contact.links.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="btn inline-block"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </Window>
</div>