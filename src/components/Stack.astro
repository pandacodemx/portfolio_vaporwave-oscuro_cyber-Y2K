---
import Window from './Window.astro';
import { getLangFromUrl } from '../i18n/utils';
import { stack } from '../data/content';

const lang = getLangFromUrl(Astro.url);
---

<div id="stack" class="scroll-mt-6">
  <Window id="win-stack" title={stack.title[lang]} tone="cyan">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        stack.groups.map((group) => (
          <div>
            <h3 class="font-pixel-bold text-xs tracking-wider text-neon-pink uppercase">
              {group.name[lang]}
            </h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => <li class="chip">{item}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </Window>
</div>