---
import Window from "./Window.astro";
import { getLangFromUrl } from "../i18n/utils";
import { about } from "../data/content";

const lang = getLangFromUrl(Astro.url);

const labels = {
  es: {
    path: "PANDACODEMX",
    info: "INFORMACIÓN_DEL_SISTEMA",
    loaded: "PERFIL CARGADO CORRECTAMENTE",
    status: "LISTO",
  },
  en: {
    path: "USER_PROFILE",
    info: "SYSTEM_INFORMATION",
    loaded: "PROFILE LOADED SUCCESSFULLY",
    status: "READY",
  },
};

const ui = labels[lang];
---

<div id="about" class="scroll-mt-6">
  <Window id="win-about" title={about.title[lang]}>
    <div class="space-y-5">
      <!-- Ruta estilo terminal -->
      <div class="flex flex-wrap items-center gap-2 border-b border-edge pb-3">
        <span class="font-pixel text-lg text-neon-cyan"> &gt;_ </span>

        <span class="font-pixel-bold text-[10px] tracking-wider text-neon-cyan">
          C:\USERS\SAID\{ui.path}
        </span>
      </div>

      <!-- Contenido principal -->
      <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[1.4fr_1fr]">
        <!-- Biografía -->
        <div class="min-w-0 space-y-4">
          <div class="flex items-center gap-2">
            <span
              aria-hidden="true"
              class="sparkle size-3 shrink-0 bg-neon-pink"></span>

            <h3
              class="font-cyber text-lg font-semibold leading-snug text-neon-pink"
            >
              {about.heading[lang]}
            </h3>
          </div>

          <div class="space-y-3 border-l-2 border-edge pl-4">
            {
              about.paragraphs[lang].map((text) => (
                <p class="font-pixel text-[20px] leading-[1.35] text-ink-dim">
                  {text}
                </p>
              ))
            }
          </div>

          <!-- Indicador de terminal -->
          <div class="flex items-center gap-2 pt-2">
            <span class="font-pixel text-lg text-neon-cyan"> &gt; </span>

            <span class="font-pixel text-lg text-ink-dim"> _ </span>
          </div>
        </div>

        <!-- Propiedades del perfil -->
        <aside class="bevel-in min-w-0 bg-night">
          <div class="flex items-center gap-2 border-b border-edge px-3 py-2">
            <span
              aria-hidden="true"
              class="sparkle size-2.5 shrink-0 bg-neon-cyan"></span>

            <h4
              class="font-pixel-bold text-[10px] tracking-wider text-neon-cyan uppercase"
            >
              {ui.info}
            </h4>
          </div>

          <dl class="divide-y divide-edge/50 px-3">
            {
              about.facts[lang].map((fact) => (
                <div class="py-3 first:pt-3 last:pb-3">
                  <dt class="mb-1 font-pixel-bold text-[10px] tracking-wider text-neon-pink uppercase">
                    {fact.label}
                  </dt>

                  <dd class="font-pixel text-[20px] leading-tight text-ink">
                    {fact.value}
                  </dd>
                </div>
              ))
            }
          </dl>
        </aside>
      </div>

      <!-- Footer interno -->
      <div
        class="flex flex-wrap items-center justify-between gap-2 border-t border-edge pt-3"
      >
        <span class="font-pixel text-base tracking-wide text-ink-dim">
          {ui.loaded}
        </span>

        <span class="flex items-center gap-2 font-pixel text-base text-acid">
          <span class="size-1.5 bg-acid"></span>
          {ui.status}
        </span>
      </div>
    </div>
  </Window>
</div>
