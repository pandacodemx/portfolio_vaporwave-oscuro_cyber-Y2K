---
/**
 * Ciudad en silueta para los costados del fondo (solo tema oscuro).
 * Se genera con código y una semilla fija, así que es idéntica en cada build.
 * Cambia `seed` para obtener otra ciudad, o ajusta las constantes de abajo.
 */
interface Props {
  class?: string;
  /** Número cualquiera: cada valor genera una ciudad distinta */
  seed?: number;
  /** Espeja la ciudad (para el lado derecho) */
  flip?: boolean;
}
const { class: className = '', seed = 1, flip = false } = Astro.props;

// ---- Ajustes ----
const W = 400; // ancho del lienzo
const H = 300; // alto del lienzo
const WINDOW_CHANCE = 0.24; // probabilidad de ventana encendida (0 a 1)
const colors = ['#00f0ff', '#ff2bd6', '#fff35c']; // cian, rosa, amarillo

// Generador pseudoaleatorio con semilla (mulberry32)
let s = seed * 9301 + 49297;
const rand = () => {
  s = (s + 0x6d2b79f5) | 0;
  let t = Math.imul(s ^ (s >>> 15), 1 | s);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const between = (a: number, b: number) => a + rand() * (b - a);

type Building = { x: number; y: number; w: number; h: number; antenna: boolean };

/** Edificios altos en el borde de la pantalla y más bajos hacia el centro (el sol). */
function makeRow(minW: number, maxW: number, heightScale: number, gap: number): Building[] {
  const row: Building[] = [];
  let x = -10;
  while (x < W) {
    const w = between(minW, maxW);
    const t = Math.min(Math.max(x / W, 0), 1);
    const falloff = 1 - 0.78 * t * t; // 1 en el borde, ~0.22 junto al sol
    const h = Math.min(H - 6, H * heightScale * falloff * between(0.62, 1));
    row.push({ x, y: H - h, w, h, antenna: h > H * 0.5 && rand() > 0.55 });
    x += w + gap;
  }
  return row;
}

const far = makeRow(30, 56, 0.7, -6); // se solapan: fondo continuo
const near = makeRow(34, 60, 0.95, 3);

// Ventanas de los edificios cercanos, agrupadas por color (un <path> por color)
const lit: string[] = colors.map(() => '');
const blink: string[] = colors.map(() => '');
const PITCH_X = 11;
const PITCH_Y = 13;

for (const b of near) {
  for (let cx = b.x + 5; cx + 4 <= b.x + b.w - 4; cx += PITCH_X) {
    for (let cy = b.y + 12; cy + 5 <= H - 8; cy += PITCH_Y) {
      if (rand() > WINDOW_CHANCE) continue;
      const c = Math.floor(rand() * colors.length);
      const d = `M${cx.toFixed(1)} ${cy.toFixed(1)}h4v5h-4z`;
      if (rand() > 0.88) blink[c] += d;
      else lit[c] += d;
    }
  }
}

const roofs = near.map((b) => `M${b.x.toFixed(1)} ${b.y.toFixed(1)}h${b.w.toFixed(1)}`).join('');
const antennas = near
  .filter((b) => b.antenna)
  .map((b) => `M${(b.x + b.w / 2).toFixed(1)} ${b.y.toFixed(1)}v-18`)
  .join('');
const beacons = near.filter((b) => b.antenna);

const uid = `sk${seed}`;
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  aria-hidden="true"
  focusable="false"
  class:list={['block h-auto w-[clamp(120px,22vw,440px)]', flip && '-scale-x-100', className]}
>
  <defs>
    <!-- Más claro hacia abajo: simula el resplandor del atardecer -->
    <linearGradient id={`${uid}-far`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1b0d3d"></stop>
      <stop offset="1" stop-color="#4a1470"></stop>
    </linearGradient>
    <linearGradient id={`${uid}-near`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#07030f"></stop>
      <stop offset="1" stop-color="#1f0a3c"></stop>
    </linearGradient>
  </defs>

  <!-- Capa lejana: solo silueta -->
  <g fill={`url(#${uid}-far)`} opacity="0.85">
    {far.map((b) => <rect x={b.x} y={b.y} width={b.w} height={b.h + 4} />)}
  </g>

  <!-- Capa cercana -->
  <g fill={`url(#${uid}-near)`}>
    {near.map((b) => <rect x={b.x} y={b.y} width={b.w} height={b.h + 4} />)}
  </g>

  <!-- Borde de neón en los techos y antenas -->
  <path d={roofs} stroke="#ff2bd6" stroke-opacity="0.55" stroke-width="1.5" fill="none"></path>
  <path d={antennas} stroke="#9a92c4" stroke-opacity="0.6" stroke-width="1" fill="none"></path>
  {
    beacons.map((b) => (
      <rect
        x={b.x + b.w / 2 - 1.5}
        y={b.y - 21}
        width="3"
        height="3"
        fill="#ff2bd6"
        class="animate-pulse"
      />
    ))
  }

  <!-- Ventanas encendidas -->
  {lit.map((d, i) => d && <path d={d} fill={colors[i]} opacity="0.85" />)}
  {blink.map((d, i) => d && <path d={d} fill={colors[i]} class="animate-pulse" />)}
</svg>