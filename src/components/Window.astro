---
/**
 * Ventana retro reutilizable.
 *
 * Uso:
 *   <Window id="about" title="sobre_mi.exe">contenido</Window>
 *   <Window id="err" title="error.sys" tone="cyan">
 *     contenido
 *     <Fragment slot="status">Listo</Fragment>   <!-- barra de estado opcional -->
 *   </Window>
 *
 * Los botones llevan data-window-action="minimize|maximize|close";
 * el comportamiento vive en src/scripts/desktop.ts (necesita un `id` único).
 */
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  title: string;
  /** Identificador único (lo usan la barra de tareas y el script) */
  id?: string;
  /** Color de la barra de título */
  tone?: 'pink' | 'cyan';
  /** Mostrar botones minimizar / maximizar / cerrar */
  controls?: boolean;
  class?: string;
  compact?: boolean;
}

const {
  title,
  id,
  tone = 'pink',
  controls = true,
  compact = false,
  class: className = '',
} = Astro.props;

const t = useTranslations(getLangFromUrl(Astro.url));
const titleId = id ? `${id}-title` : undefined;
const hasStatus = Astro.slots.has('status');
---

<section
  id={id}
  data-window
  data-state="open"
  data-active="true"
  tabindex="-1"
  aria-labelledby={titleId}
  class:list={['window group/win bevel-out min-w-0 bg-panel p-1 text-ink outline-none', className]}
>
  <header
    data-window-handle
    class:list={[
      'titlebar flex h-8 items-center gap-2 px-1.5 select-none',
      tone === 'cyan' && 'titlebar-cyan',
    ]}
  >
    <span aria-hidden="true" class="sparkle block size-3.5 shrink-0 bg-white/90"></span>

    <h2
      id={titleId}
      class="min-w-0 flex-1 truncate font-pixel-bold text-xs tracking-wider text-white uppercase"
    >
      {title}
    </h2>

    {
      controls && (
        <div class="flex shrink-0 gap-1">
          <button
            type="button"
            data-window-action="minimize"
            aria-label={t('window.minimize')}
            title={t('window.minimize')}
            class="winbtn"
          >
            <svg viewBox="0 0 10 10" class="size-2.5" fill="currentColor" aria-hidden="true">
              <rect x="1" y="7" width="6" height="2" />
            </svg>
          </button>
          <button
            type="button"
            data-window-action="maximize"
            data-label-max={t('window.maximize')}
            data-label-restore={t('window.restore')}
            aria-label={t('window.maximize')}
            title={t('window.maximize')}
            class="winbtn"
          >
            <!-- Maximizar -->
            <svg
              viewBox="0 0 10 10"
              class="size-2.5 group-[.is-maximized]/win:hidden"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <rect x="1.5" y="1.5" width="7" height="7" />
            </svg>
            <!-- Restaurar -->
            <svg
              viewBox="0 0 10 10"
              class="hidden size-2.5 group-[.is-maximized]/win:block"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <rect x="3" y="1" width="6" height="6" />
              <rect x="1" y="3" width="6" height="6" fill="var(--color-panel)" />
            </svg>
          </button>
          <button
            type="button"
            data-window-action="close"
            aria-label={t('window.close')}
            title={t('window.close')}
            class="winbtn"
          >
            <svg
              viewBox="0 0 10 10"
              class="size-2.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="square"
              aria-hidden="true"
            >
              <path d="M1.5 1.5l7 7M8.5 1.5l-7 7" />
            </svg>
          </button>
        </div>
      )
    }
  </header>

  <div
  class:list={[
    'window-content bevel-in mt-1 bg-void/70',
    compact
      ? 'p-3 text-base leading-normal'
      : 'p-4 text-xl leading-snug',
  ]}
>
  <slot />
</div>

  {
    hasStatus && (
      <footer class="bevel-in mt-1 flex h-7 items-center px-2 text-base text-ink-dim">
        <slot name="status" />
      </footer>
    )
  }
</section>
