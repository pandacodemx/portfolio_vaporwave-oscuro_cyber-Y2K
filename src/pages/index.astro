<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Portfolio PandaCode.exe</title>
    <meta name="theme-color" content="#0a0614" />
    <!-- Sin JS: va a español -->
    <noscript><meta http-equiv="refresh" content="0;url=/es/" /></noscript>
    <link rel="canonical" href="/es/" />
    <script is:inline>
      // Redirección idioma del navegador.
      var lang = (navigator.language || 'es').toLowerCase().startsWith('en') ? 'en' : 'es';
      location.replace('/' + lang + '/');
    </script>
  </head>
  <body style="background:#0a0614">
    <a href="/es/" style="color:#00f0ff;font-family:monospace">/es/</a> ·
    <a href="/en/" style="color:#00f0ff;font-family:monospace">/en/</a>
  </body>
</html>
